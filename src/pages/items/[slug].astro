---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceLinks from '../../components/SourceLinks.astro';
import ExclusionTable from '../../components/ExclusionTable';
import Icon from '../../components/Icon.astro';
import { rowId } from '../../lib/rowId';
import { platformOf } from '../../lib/platform';

export async function getStaticPaths() {
  const items = await getCollection('items');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const vendor = await getEntry('vendors', item.data.vendor);
const sources = item.data.sources;
const sourceLabel = new Map(sources.map((s) => [s.url, s.label]));
const multiSource = sources.length > 1;

const allItems = await getCollection('items');
const related = item.data.related
  .map((slug) => allItems.find((other) => other.id === slug))
  .filter((other) => other !== undefined)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const reviewed = item.data.lastReviewed?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const rows = item.data.exclusions.map((exclusion) => {
  // A row without its own source comes from the item's only source.
  const source = exclusion.source || (sources.length === 1 ? sources[0].url : '');
  return {
  id: rowId(item.id, exclusion.path, exclusion.type),
  path: exclusion.path,
  type: exclusion.type,
  description: exclusion.description,
  justification: exclusion.justification,
  condition: exclusion.condition,
  status: exclusion.status,
  source,
  sourceLabel: sourceLabel.get(source) ?? '',
  platform: platformOf(exclusion.path),
  };
});
---

<BaseLayout title={item.data.title}>
  <div class="breadcrumb">
    <a href="/">Vendors</a>
    <span>/</span>
    {vendor && <a href={`/vendors/${vendor.id}/`}>{vendor.data.title}</a>}
    <span>/</span>
    <span>{item.data.title}</span>
  </div>

  <div class="item-heading">
    <h1>{item.data.title}</h1>
    {vendor && (
      <a href={`/vendors/${vendor.id}/`} class="badge badge-accent">
        {vendor.data.title}
      </a>
    )}
  </div>

  <div class="prose">
    <Content />
  </div>

  <SourceLinks sources={item.data.sources} />

  {reviewed && <p class="reviewed">Last checked against the sources: {reviewed}</p>}

  {
    related.length > 0 && (
      <p class="related">
        Related:{' '}
        {related.map((other, index) => (
          <>
            {index > 0 && ', '}
            <a href={`/items/${other.id}/`}>{other.data.title}</a>
          </>
        ))}
      </p>
    )
  }

  {
    item.data.notes.length > 0 && (
      <div class="notes">
        {item.data.notes.map((note) => (
          <div class={`callout ${note.kind === 'warning' ? 'callout-warning' : 'callout-note'}`}>
            {note.kind === 'warning' && <Icon name="alert-triangle" size={16} />}
            <p>
              {note.kind !== 'note' && <strong>{note.kind === 'extra' ? 'Extra: ' : 'Warning: '}</strong>}
              {note.text}
            </p>
          </div>
        ))}
      </div>
    )
  }

  {
    rows.length > 0 ? (
      <ExclusionTable client:visible itemSlug={item.id} itemTitle={item.data.title} rows={rows} showSource={multiSource} />
    ) : (
      <p class="empty-state">No exclusions have been documented for this product yet.</p>
    )
  }

  <style>
    .breadcrumb {
      display: flex;
      gap: 6px;
      font-size: 13px;
      color: var(--color-text-muted);
      margin-bottom: 10px;
    }

    .breadcrumb a {
      color: var(--color-text-muted);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      color: var(--color-text);
    }

    .item-heading {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .item-heading h1 {
      margin: 0;
    }

    .item-heading .badge {
      text-decoration: none;
    }

    .prose {
      color: var(--color-text-secondary);
      max-width: 620px;
      margin: 8px 0 16px;
    }

    .notes {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }

    .notes p {
      margin: 0;
    }

    .reviewed,
    .related {
      font-size: 13px;
      color: var(--color-text-muted);
      margin: 0 0 10px;
    }

    .related a {
      color: var(--color-text-secondary);
    }

    .empty-state {
      color: var(--color-text-muted);
    }
  </style>
</BaseLayout>
