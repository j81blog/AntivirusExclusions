---
import { getCollection } from 'astro:content';

const vendors = (await getCollection('vendors')).sort((a, b) => a.data.order - b.data.order);
const items = await getCollection('items');

const path = Astro.url.pathname;
const currentItem = items.find((item) => path.startsWith(`/items/${item.id}/`));
const currentVendor = currentItem?.data.vendor ?? vendors.find((v) => path.startsWith(`/vendors/${v.id}/`))?.id;

// Drop the vendor name in front of item titles; the group heading already shows it.
function shortTitle(title: string, vendorTitle: string) {
  return title.startsWith(`${vendorTitle} `) ? title.slice(vendorTitle.length + 1) : title;
}

const groups = vendors.map((vendor) => ({
  id: vendor.id,
  title: vendor.data.title,
  items: items
    .filter((item) => item.data.vendor === vendor.id)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map((item) => ({ id: item.id, title: shortTitle(item.data.title, vendor.data.title) })),
}));
---

<nav class="sidenav" id="browse" aria-label="Products">
  <a href="/" class:list={['sidenav-home', { current: path === '/' }]}>All vendors</a>
  {
    groups.map((group) => (
      <details class="sidenav-group" open={group.id === currentVendor}>
        <summary>
          <span>{group.title}</span>
          <span class="sidenav-count">{group.items.length}</span>
        </summary>
        <ul>
          <li>
            <a href={`/vendors/${group.id}/`} class:list={['sidenav-overview', { current: path === `/vendors/${group.id}/` }]}>
              Overview
            </a>
          </li>
          {group.items.map((item) => (
            <li>
              <a
                href={`/items/${item.id}/`}
                class:list={{ current: currentItem?.id === item.id }}
                aria-current={currentItem?.id === item.id ? 'page' : undefined}
              >
                {item.title}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
  <a href="/downloads" class:list={['sidenav-home', { current: path.startsWith('/downloads') }]}>Selected exclusions</a>
</nav>

<style>
  .sidenav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
  }

  .sidenav a {
    display: block;
    color: var(--color-text-secondary);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 6px;
    line-height: 1.35;
  }

  .sidenav a:hover {
    background: var(--color-bg-subtle);
    color: var(--color-text);
  }

  .sidenav a.current {
    background: var(--color-accent-bg);
    color: var(--color-accent);
    font-weight: 500;
  }

  .sidenav-home {
    font-weight: 500;
  }

  .sidenav-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 500;
    color: var(--color-text);
    list-style: none;
  }

  .sidenav-group summary::-webkit-details-marker {
    display: none;
  }

  .sidenav-group summary::before {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--color-text-muted);
    border-bottom: 1.5px solid var(--color-text-muted);
    transform: rotate(-45deg);
    margin-right: 4px;
    flex-shrink: 0;
    transition: transform 0.15s;
  }

  .sidenav-group[open] summary::before {
    transform: rotate(45deg);
  }

  .sidenav-group summary span:first-child {
    flex-grow: 1;
  }

  .sidenav-group summary:hover {
    background: var(--color-bg-subtle);
  }

  .sidenav-count {
    font-size: 11px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .sidenav ul {
    list-style: none;
    margin: 0 0 6px;
    padding: 0 0 0 14px;
    border-left: 1px solid var(--color-border);
    margin-left: 13px;
  }

  .sidenav-overview {
    font-style: italic;
  }
</style>
